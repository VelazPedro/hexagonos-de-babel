        (id: "tonico_vivo", target: "tonic", name: "Tónico vivo", text: "Cada tónico también devuelve energía.", effect: Perk(TonicSpirit), values: (25.0, 50.0, 80.0)),
        (id: "tonico_rendidor", target: "tonic", name: "Tónico rendidor", text: "De cada tanda salen más tónicos.", effect: Perk(TonicBatch), values: (1.0, 1.0, 2.0)),

        (id: "tinta_abundante", target: "ink", name: "Tinta abundante", text: "Cada destilado rinde más tinta.", effect: Perk(InkBatch), values: (1.0, 2.0, 3.0)),
        (id: "tinta_fina", target: "ink", name: "Tinta fina", text: "Inscribir tu equipo gasta menos tinta.", effect: Stat(InscribeDiscount), values: (0.10, 0.18, 0.25)),
