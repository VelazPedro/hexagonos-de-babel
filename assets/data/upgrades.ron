        (id: "lente_buscadora", target: "lens", name: "Lente buscadora", text: "Lo que está tirado vuela hacia vos desde más lejos.", effect: Stat(Magnet), values: (0.20, 0.35, 0.50)),
        (id: "lente_memoriosa", target: "lens", name: "Lente memoriosa", text: "Todo te da más experiencia.", effect: Stat(XpBonus), values: (0.05, 0.08, 0.12)),

