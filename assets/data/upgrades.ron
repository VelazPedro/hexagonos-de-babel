// Mejoras de las mesas: en cada objeto se elige una, de nivel I a III.
(
    // El precio de cada nivel, igual para todo lo de una mesa.
    prices: [
        (station: Forge, levels: [
            [(Iron, 4), (Stone, 6)],
            [(Silver, 4), (Ash, 4)],
            [(Crystal, 4), (Salt, 6)],
        ]),
        (station: Binder, levels: [
            [(Iron, 2), (Leather, 6), (Fiber, 6)],
            [(Silver, 3), (Leather, 10), (Ink, 4)],
            [(Crystal, 3), (Paper, 20), (Bone, 6)],
        ]),
        (station: Alembic, levels: [
            [(Iron, 2), (Ink, 4), (Fiber, 6)],
            [(Silver, 3), (Ink, 8), (Ash, 6)],
            [(Crystal, 3), (Ink, 10), (Salt, 6)],
        ]),
    ],
    // Nivel de la herramienta que pide cada nivel de templado.
    tool_tiers: (1, 3, 4),
    targets: [
        (id: "knife", name: "Cuchilla", station: Forge, tool: Some(Knife)),
        (id: "hammer", name: "Martillo", station: Forge, tool: Some(Hammer)),
        (id: "lamp", name: "Lámpara", station: Forge, tool: Some(Lamp)),
        (id: "lens", name: "Lente", station: Forge, tool: Some(Lens)),
        (id: "cover", name: "Cuaderno", station: Binder),
        (id: "pages", name: "Páginas", station: Binder, skill: Some(RangedPages)),
        (id: "torches", name: "Antorchas", station: Binder, skill: Some(Torches)),
        (id: "tonic", name: "Tónico", station: Alembic),
        (id: "ink", name: "Tinta", station: Alembic),
    ],
    upgrades: [
        (id: "filo_igneo", target: "knife", name: "Filo ígneo", text: "Tus golpes pueden prender fuego.", effect: Stat(BurnChance), values: (0.08, 0.12, 0.16)),
        (id: "filo_sediento", target: "knife", name: "Filo sediento", text: "Recuperás vida con parte del daño que hacés.", effect: Stat(Lifesteal), values: (0.02, 0.03, 0.04)),
        (id: "filo_gemelo", target: "knife", name: "Filo gemelo", text: "A veces el golpe se repite con la mitad de fuerza.", effect: Stat(EchoChance), values: (0.06, 0.09, 0.12)),

        (id: "cantero", target: "hammer", name: "Cantero", text: "Sacás más materiales de lo que rompés con el martillo.", effect: Perk(HammerExtra), values: (1.0, 2.0, 3.0)),
        (id: "golpe_seco", target: "hammer", name: "Golpe seco", text: "Con el martillo rompés más rápido.", effect: Perk(HammerPower), values: (0.20, 0.35, 0.50)),
        (id: "mazazo", target: "hammer", name: "Mazazo", text: "Tus golpes empujan más lejos a los enemigos.", effect: Stat(Knockback), values: (0.20, 0.35, 0.50)),

        (id: "mecha_clara", target: "lamp", name: "Mecha clara", text: "Tu farol alumbra más lejos.", effect: Stat(LightRadius), values: (0.08, 0.12, 0.16)),
        (id: "llama_cazadora", target: "lamp", name: "Llama cazadora", text: "En sitios oscuros pegás más fuerte.", effect: Stat(DarkDamage), values: (0.10, 0.15, 0.20)),
        (id: "brasa", target: "lamp", name: "Brasa", text: "El calor del farol te va curando.", effect: Stat(HpRegen), values: (0.3, 0.5, 0.8)),

