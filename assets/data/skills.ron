    (id: "r_frases", name: "Oído de frases", description: "Las frases leídas enseñan sus dos palabras con experiencia doble.", branch: Reader, row: 2, col: 0, requires: ["r_pagina"], unlock: PhraseInsight),
    (id: "r_saber", name: "Memoria", description: "+10% de experiencia de toda fuente.", branch: Reader, row: 2, col: 1, requires: ["r_trazo"], stats: [(XpBonus, 0.10)]),
