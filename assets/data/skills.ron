    (id: "r_trazo2", name: "Pulso de copista", description: "Inscribir cuesta otro 20% menos.", branch: Reader, row: 3, col: 0, requires: ["r_frases"], stats: [(InscribeDiscount, 0.20)]),
    (id: "r_erudito", name: "Erudición", description: "+30% de saber al leer y +10% de experiencia.", branch: Reader, row: 4, col: 0, requires: ["r_trazo2", "r_doble"], stats: [(ReadBonus, 0.30), (XpBonus, 0.10)]),

